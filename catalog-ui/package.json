{
  "name": "catalog-ui",
  "version": "1707.1.0",
  "description": "SDC Single page application",
  "main": "src/main.ts",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git@gitlab:root/D2-SDnC.git"
  },
  "scripts": {
    "designer": "npm start -- --env.role designer",
    "admin": "npm start -- --env.role admin",
    "start": "node tools/dev-server.js",
    "start:local": "node tools/dev-server.js",
    "build": "ng build --configuration development --aot=false",
    "build:prod": "ng build --prod --aot --build-optimizer=false --deploy-url /sdc1/ && node tools/package-production.js",
    "lint": "tslint -c tslint.json 'src/**/*.ts'",
    "pretest": "npm run test:tools",
    "test": "jest --coverage",
    "test:tools": "jest --config tools/jest.config.js --runInBand",
    "test:watch": "jest --watch",
    "cypress": "npx cypress run",
    "cypress-headless": "start-server-and-test start http-get://localhost:9000 cypress"
  },
  "jest": {
    "preset": "jest-preset-angular",
    "collectCoverageFrom": [
      "<rootDir>/src/app/**/*.ts",
      "!**/*.module.ts",
      "!**/index.ts",
      "!**/*.d.ts"
    ],
    "coverageDirectory": "<rootDir>/target/code-coverage/",
    "coverageReporters": [
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 35,
        "functions": 26,
        "lines": 37,
        "statements": 38
      }
    },
    "setupFilesAfterEnv": [
      "<rootDir>/src/jest/setup-jest.ts"
    ],
    "globals": {
      "ts-jest": {
        "isolatedModules": true,
        "tsConfig": "<rootDir>/src/tsconfig.spec.json",
        "stringifyContentPathRegex": "\\.html$",
        "astTransformers": [
          "jest-preset-angular/InlineHtmlStripStylesTransformer"
        ]
      }
    },
    "transformIgnorePatterns": [
      "<rootDir>/node_modules/(?!onap-ui-angular)"
    ],
    "verbose": true,
    "roots": [
      "<rootDir>/src/app/"
    ],
    "testEnvironment": "jest-environment-jsdom-thirteen",
    "testURL": "http://localhost/",
    "transform": {
      "^.+\\.(ts|html)$": "ts-jest",
      "^.+\\.js$": [
        "babel-jest",
        {
          "presets": [
            "@babel/preset-env"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "@angular/cli": "8.3.29",
    "@angular-devkit/build-angular": "0.803.29",
    "@types/jest": "24.9.1",
    "@babel/core": "7.12.17",
    "@babel/preset-env": "7.12.17",
    "babel-jest": "24.9.0",
    "axe-core": "^4.4.0",
    "cypress-axe": "^1.0.0",
    "jest-axe": "^5.0.1",
    "codelyzer": "5.2.2",
    "apache-server-configs": "^2.7.1",
    "cors": "2.7.1",
    "cypress": "^9.7.0",
    "express": "^4.14.0",
    "http-proxy-middleware": "^0.14.0",
    "jest": "24.9.0",
    "jest-dom": "^1.3.1",
    "jest-preset-angular": "7.1.1",
    "jshint-stylish": "2.2.1",
    "json-loader": "^0.5.4",
    "load-grunt-tasks": "3.5.2",
    "onap-ui-common": "1.4.0",
    "parse5": "4.0.0",
    "start-server-and-test": "^1.9.1"
  },
  "engines": {},
  "dependencies": {
    "@angular/animations": "8.2.14",
    "@angular/common": "8.2.14",
    "@angular/compiler": "8.2.14",
    "@angular/compiler-cli": "8.2.14",
    "@angular/core": "8.2.14",
    "@angular/forms": "8.2.14",
    "@angular/platform-browser": "8.2.14",
    "@angular/platform-browser-dynamic": "8.2.14",
    "@angular/router": "8.2.14",
    "@bardit/cytoscape-expand-collapse": "^2.0.3",
    "@bardit/cytoscape-qtip": "^2.5.1",
    "@ng-select/ng-select": "3.7.3",
    "@ngxs/devtools-plugin": "3.5.1",
    "@ngxs/logger-plugin": "3.5.1",
    "@ngxs/store": "3.5.1",
    "@swimlane/ngx-datatable": "15.0.2",
    "@types/core-js": "^0.9.35",
    "@types/jquery": "^2.0.52",
    "@types/js-md5": "^0.4.0",
    "@types/node": "7.0.7",
    "@types/q": "0.0.32",
    "angular2-draggable": "1.1.0",
    "angular2-uuid": "^1.1.1",
    "animate.css": "^3.5.2",
    "bootstrap": "^3.3.7",
    "core-js": "^2.4.1",
    "cytoscape": "^2.7.15",
    "jquery": "^3.6.0",
    "jqueryui": "^1.11.1",
    "js-md5": "^0.4.2",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.0",
    "less": "~3.9.0",
    "lodash": "^4.17.2",
    "ngx-drag-drop": "2.0.0",
    "onap-ui-angular": "6.0.0",
    "perfect-scrollbar": "^0.6.16",
    "qtip2": "^3.0.3",
    "rxjs": "6.5.5",
    "sdc-pubsub": "^1.0.30",
    "ts-mockery": "^1.1.0",
    "tslint": "^5.12.1",
    "typescript": "3.5.3",
    "underscore": "^1.8.3",
    "zone.js": "0.9.1"
  },
  "resolutions": {}
}
