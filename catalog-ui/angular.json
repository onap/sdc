{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "catalog-ui": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist",
            "index": "src/index.html",
            "main": "src/main.ts",
            "tsConfig": "src/tsconfig.app.json",
            "polyfills": "src/polyfills.ts",
            "assets": [
              "src/assets/preloading.css",
              "src/assets/languages",
              "src/assets/styles/fonts",
              "src/assets/styles/images",
              "src/assets/styles/app.css",
              {
                "glob": "**/*",
                "input": "configurations",
                "output": "/configurations"
              }
            ],
            "styles": [
              "src/styles.less"
            ],
            "scripts": [
              "node_modules/jquery/dist/jquery.min.js",
              "node_modules/lodash/lodash.min.js",
              "node_modules/jqueryui/jquery-ui.min.js",
              "node_modules/cytoscape/dist/cytoscape.min.js",
              "node_modules/perfect-scrollbar/dist/js/perfect-scrollbar.jquery.min.js",
              "node_modules/qtip2/dist/jquery.qtip.min.js",
              "node_modules/@bardit/cytoscape-qtip/cytoscape-qtip.js",
              "node_modules/js-md5/build/md5.min.js"
            ]
          },
          "configurations": {
            "development": {
              "aot": false,
              "optimization": false,
              "buildOptimizer": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "extractCss": true,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": false,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "catalog-ui:build"
          },
          "configurations": {
            "development": {
              "browserTarget": "catalog-ui:build:development"
            },
            "production": {
              "browserTarget": "catalog-ui:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "catalog-ui:build"
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": [],
            "exclude": []
          }
        }
      }
    },
    "catalog-ui-e2e": {
      "root": "e2e",
      "sourceRoot": "e2e",
      "projectType": "application"
    }
  },
  "defaultProject": "catalog-ui"
}